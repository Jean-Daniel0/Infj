# Configuration Supabase
# Remplacez ces valeurs par vos vraies clés Supabase

# URL de votre projet Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique anonyme de Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Configuration optionnelle
VITE_APP_NAME=Institut National de Formation des Jeunes
VITE_APP_VERSION=1.0.0

# Configuration email (optionnel)
VITE_EMAIL_FROM=noreply@infj.com
VITE_EMAIL_TO=contact@infj.com

# Configuration d'environnement Sandbox pour MonCash via Bazik (vrai ou faux)
BAZIK_SANDBOX=true
MONCASH_SANDBOX=true



